# Copy to .env.local and fill in your own values. Never commit .env.local.

# Clerk → API keys → Publishable key (safe to ship in the app)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Written for you by `npx convex dev`
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=

# Clerk → Convex integration → Frontend API URL, e.g. https://your-app.clerk.accounts.dev
# Convex reads this from its own deployment, so also run:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Optional. Only `npm run seed:demo` uses it, and only against a Clerk development instance.
# The app never reads it. Keep it out of anything prefixed EXPO_PUBLIC_.
CLERK_SECRET_KEY=
