{
  "expo": {
    "name": "Foldspace",
    "slug": "foldspace",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/foldspace-icon.png",
    "scheme": "foldspace",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/foldspace-icon.png",
      "bundleIdentifier": "com.papareact.foldspace",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.papareact.foldspace"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo-native-components",
      "expo-sharing",
      "expo-secure-store",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose images to add to your private Foldspace canvases.",
          "cameraPermission": false,
          "microphonePermission": "Record voice notes onto your Foldspace canvases."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F1",
          "image": "./assets/images/foldspace-icon.png",
          "imageWidth": 90
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice notes onto your Foldspace canvases."
        }
      ],
      "expo-maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
